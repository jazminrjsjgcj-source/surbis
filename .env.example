# Plantilla de entorno del proyecto.
#
#     cp .env.example .env
#
# Y despues rellena UNICAMENTE DB_PASSWORD y SEED_PASSWORD.
#
# Este archivo sustituye al .env.example que genera Laravel: trae ya la
# configuracion que el proyecto necesita (PostgreSQL, Redis, espanol, UTC) en
# lugar de los valores por defecto que habria que corregir a mano.
#
# Aqui no hay ninguna contrasena, ni de ejemplo.

APP_NAME=Encuestas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Espanol de partida. El sistema debe poder funcionar despues en arabe sin
# reescribir vistas: ANEXO 1 secciones 49 y 50.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Se almacena en UTC y se muestra en la zona de cada organizacion.
# RNF-GEN-013. Esto no se cambia por comodidad local.
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# pgsql es el nombre del servicio en docker-compose.yml, no una direccion.
# Desde DBeaver, en cambio, se conecta a localhost con FORWARD_DB_PORT.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=encuestas
DB_USERNAME=encuestas
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax

# false en local porque no hay TLS y con true no habria sesion.
# En produccion es true, y es RNF-GEN-003.
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# El codigo del segundo factor y las ligas de restablecimiento salen en
# storage/logs/laravel.log mientras el mailer sea "log". Produccion necesita
# un proveedor real: es P-013.
MAIL_MAILER=log

# Contrasena de las cuentas que crea DevelopmentSeeder. Sin valor por defecto
# a proposito: el seeder se niega a correr sin ella y dice que poner.
SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Docker. Estas cuatro las lee docker-compose.yml, no Laravel.
# ---------------------------------------------------------------------------

# En Linux deben coincidir con tu usuario o los archivos que cree el
# contenedor perteneceran a otro y no podras editarlos.
#   id -u   e   id -g
# En macOS y Windows con Docker Desktop, deja 1000.
UID=1000
GID=1000

# http://localhost:8080
APP_PORT=8080

# Puerto del host para DBeaver. Cambialo si ya tienes PostgreSQL en el 5432.
FORWARD_DB_PORT=5434
